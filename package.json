{
  "name": "vue-product-showcase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "deploy": "gh-pages -d dist",
    "test:unit": "jest",
    "test:unit:coverage": "jest --coverage",
    "test:e2e": "start-server-and-test serve http://localhost:8080 cy:run",
    "cy:open": "cypress open",
    "api": "json-server --watch db.json --port 3000",
    "cy:run": "cypress run"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.20.0",
    "core-js": "^3.8.3",
    "vue": "^3.2.13",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.6",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "cypress": "^16.1.1",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "flush-promises": "^1.0.2",
    "gh-pages": "^6.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "json-server": "^0.17.4",
    "sass": "^1.105.1",
    "start-server-and-test": "^3.0.12",
    "webpack-plugin-vuetify": "^3.1.3"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "vue/setup-compiler-macros": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {},
    "overrides": [
      {
        "files": [
          "**/*.spec.js",
          "tests/**/*.js"
        ],
        "env": {
          "jest": true
        }
      },
      {
        "files": [
          "cypress/**/*.js"
        ],
        "env": {
          "mocha": true
        },
        "globals": {
          "cy": "readonly",
          "Cypress": "readonly"
        }
      }
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
